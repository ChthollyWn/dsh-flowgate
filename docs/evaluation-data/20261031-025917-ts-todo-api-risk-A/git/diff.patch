 /**
  * 密码哈希（PBKDF2-SHA256，格式自带参数，便于以后升级迭代次数）。
  *
- * 基准任务 R3（风险改造）会要求把迭代次数从 100000 提到 600000，
- * 并保证旧哈希仍能登录、登录成功后自动迁移。注意这是一个安全敏感路径。
+ * 迭代次数已从 100000 提升到 600000。哈希格式自带参数，
+ * 因此旧哈希仍可校验，并在登录成功后自动迁移到当前参数。注意这是一个安全敏感路径。
  */
-export const DEFAULT_ITERATIONS = 100_000
+export const DEFAULT_ITERATIONS = 600_000
 const KEY_LENGTH = 32
 const DIGEST = 'sha256'
 
@@ -31,5 +31,9 @@ export function verifyPassword(password, stored) {
 export function needsRehash(stored, iterations = DEFAULT_ITERATIONS) {
   const parts = String(stored).split('$')
   if (parts.length !== 5) return true
-  return Number.parseInt(parts[2], 10) < iterations
+  const [scheme, digest, iterationsRaw] = parts
+  if (scheme !== 'pbkdf2' || digest !== DIGEST) return true
+  const parsed = Number.parseInt(iterationsRaw, 10)
+  if (!Number.isFinite(parsed) || parsed <= 0) return true
+  return parsed < iterations
 }
