@@ -0,0 +1,74 @@
+package com.acme.member.coupon;
+
+import java.time.LocalDateTime;
+import java.util.Locale;
+import java.util.Objects;
+
+/** 券模型：券码规范化、闭区间有效期与整数分折扣计算。 */
+public class Coupon {
+
+    private final String code;
+    private final int discountPercent;
+    private final LocalDateTime validFrom;
+    private final LocalDateTime validUntil;
+    private final boolean enabled;
+
+    public Coupon(String code, int discountPercent, LocalDateTime validFrom, LocalDateTime validUntil, boolean enabled) {
+        this.code = normalizeCode(code);
+        if (discountPercent < 1 || discountPercent > 100) {
+            throw new IllegalArgumentException("discountPercent must be between 1 and 100: " + discountPercent);
+        }
+        this.discountPercent = discountPercent;
+        this.validFrom = Objects.requireNonNull(validFrom, "validFrom");
+        this.validUntil = Objects.requireNonNull(validUntil, "validUntil");
+        if (validUntil.isBefore(validFrom)) {
+            throw new IllegalArgumentException("validUntil must not be before validFrom");
+        }
+        this.enabled = enabled;
+    }
+
+    private static String normalizeCode(String code) {
+        if (code == null || code.trim().isEmpty()) {
+            throw new IllegalArgumentException("coupon code must not be blank");
+        }
+        return code.trim().toUpperCase(Locale.ROOT);
+    }
+
+    public String getCode() {
+        return code;
+    }
+
+    public int getDiscountPercent() {
+        return discountPercent;
+    }
+
+    public LocalDateTime getValidFrom() {
+        return validFrom;
+    }
+
+    public LocalDateTime getValidUntil() {
+        return validUntil;
+    }
+
+    public boolean isEnabled() {
+        return enabled;
+    }
+
+    /** 闭区间判定：validFrom <= at <= validUntil，且券处于启用状态。 */
+    public boolean isValidAt(LocalDateTime at) {
+        Objects.requireNonNull(at, "at");
+        return enabled && !at.isBefore(validFrom) && !at.isAfter(validUntil);
+    }
+
+    /** 优惠分：原价 × 折扣百分比，按 HALF_UP 取整到分。 */
+    public long discountCents(long originalAmountCents) {
+        if (originalAmountCents <= 0) {
+            throw new IllegalArgumentException("originalAmountCents must be positive: " + originalAmountCents);
+        }
+        return (originalAmountCents * discountPercent + 50) / 100;
+    }
+
+    public long payableCents(long originalAmountCents) {
+        return originalAmountCents - discountCents(originalAmountCents);
+    }
+}
