+        assertEquals(15, repository.findByCode("RENEW15").orElseThrow().getDiscountPercent());
+        assertEquals(20, repository.findByCode("RENEW20").orElseThrow().getDiscountPercent());
+        assertTrue(repository.findByCode("EXPIRED10").isPresent());
+        assertTrue(repository.findByCode("NO-SUCH-COUPON").isEmpty());
+    }
+
+    @Test
