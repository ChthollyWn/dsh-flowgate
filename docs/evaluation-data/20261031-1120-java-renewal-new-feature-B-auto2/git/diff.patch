@@ -0,0 +1,50 @@
+package com.acme.member.coupon;
+
+import java.time.LocalDateTime;
+import java.util.Collection;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.concurrent.ConcurrentHashMap;
+
+/** 券目录仓储：默认装载内置演示券，也可注入自定义券目录。 */
+public class CouponRepository {
+
+    private final Map<String, Coupon> couponsByCode = new ConcurrentHashMap<>();
+
+    public CouponRepository() {
+        this(builtInCoupons());
+    }
+
+    public CouponRepository(Collection<Coupon> coupons) {
+        Objects.requireNonNull(coupons, "coupons");
+        for (Coupon coupon : coupons) {
+            Coupon nonNull = Objects.requireNonNull(coupon, "coupon");
+            couponsByCode.put(nonNull.getCode(), nonNull);
+        }
+    }
+
+    /** 券码 trim + 大写后查找；null 或空白返回空。 */
+    public Optional<Coupon> findByCode(String code) {
+        if (code == null || code.trim().isEmpty()) {
+            return Optional.empty();
+        }
+        String normalized = code.trim().toUpperCase(Locale.ROOT);
+        return Optional.ofNullable(couponsByCode.get(normalized));
+    }
+
+    private static List<Coupon> builtInCoupons() {
+        LocalDateTime from = LocalDateTime.parse("2024-01-01T00:00:00");
+        LocalDateTime until = LocalDateTime.parse("2026-12-31T23:59:59");
+        return List.of(
+                new Coupon("WELCOME10", 10, from, until, true),
+                new Coupon("RENEW15", 15, from, until, true),
+                new Coupon("RENEW20", 20, from, until, true),
+                new Coupon("EXPIRED10", 10,
+                        LocalDateTime.parse("2024-01-01T00:00:00"),
+                        LocalDateTime.parse("2025-01-01T00:00:00"),
+                        true));
+    }
+}
