+    private RenewalController.CallbackRequest callbackRequest(String externalTxnId,
+                                                              String memberId,
+                                                              int months,
+                                                              long amountCents,
+                                                              String couponCode,
+                                                              Long originalAmountCents) throws Exception {
+        Map<String, Object> body = new LinkedHashMap<>();
+        body.put("externalTxnId", externalTxnId);
+        body.put("memberId", memberId);
+        body.put("months", months);
+        body.put("amountCents", amountCents);
+        body.put("signature", signatureVerifier.sign(externalTxnId, amountCents));
+        if (couponCode != null) {
+            body.put("couponCode", couponCode);
+        }
+        if (originalAmountCents != null) {
+            body.put("originalAmountCents", originalAmountCents);
+        }
+        return JSON.readValue(JSON.writeValueAsString(body), RenewalController.CallbackRequest.class);
+    }
+
+    @SuppressWarnings("unchecked")
+    private ResponseEntity<Map<String, Object>> quote(String memberId,
+                                                       int months,
+                                                       Long originalAmountCents,
+                                                       String couponCode) throws Exception {
+        Map<String, Object> body = new LinkedHashMap<>();
+        body.put("memberId", memberId);
+        body.put("months", months);
+        body.put("originalAmountCents", originalAmountCents);
+        if (couponCode != null) {
+            body.put("couponCode", couponCode);
+        }
+        Class<?> requestType = Class.forName("com.acme.member.renewal.RenewalController$QuoteRequest");
+        Object request = JSON.readValue(JSON.writeValueAsString(body), requestType);
+        Method quote = RenewalController.class.getMethod("quote", requestType);
+        return (ResponseEntity<Map<String, Object>>) quote.invoke(controller, request);
+    }
+
+    private Map<String, Object> orderOf(String externalTxnId) {
+        return controller.orders().stream()
+                .filter(order -> externalTxnId.equals(order.get("externalTxnId")))
+                .findFirst()
+                .orElseThrow();
+    }
