+/**
+ * 从请求中取"当前操作人"。本仓库没有会话，演示/测试时可以用
+ * X-User-Id 请求头、actorId 查询参数或请求体里的 actorId 显式传入。
+ * 没传时保持旧接口的匿名行为，不做强制鉴权。
+ */
+function requestActor(req, url, body = {}) {
+  const safeBody = body && typeof body === 'object' ? body : {}
+  const header = req.headers['x-user-id'] ?? req.headers['x-viewer-id']
+  const value =
+    safeBody.actorId ??
+    safeBody.requesterId ??
+    safeBody.ownerId ??
+    url.searchParams.get('actorId') ??
+    url.searchParams.get('viewerId') ??
+    url.searchParams.get('requesterId') ??
+    url.searchParams.get('ownerId') ??
+    header
+  return typeof value === 'string' && value.trim().length > 0 ? value.trim() : undefined
+}
+
+/** 分享请求体里允许 sharedWith / sharedWithId / userId / email 等常见写法。 */
+function shareTargetFrom(body) {
+  const safeBody = body && typeof body === 'object' ? body : {}
+  const value =
+    safeBody.sharedWith ??
+    safeBody.sharedWithId ??
+    safeBody.sharedWithUserId ??
+    safeBody.userId ??
+    safeBody.targetUserId ??
+    safeBody.target ??
+    safeBody.to ??
+    safeBody.user
+  if (typeof value === 'string' && value.trim().length > 0) return value.trim()
+  if (value && typeof value === 'object' && typeof value.id === 'string' && value.id.trim().length > 0) {
+    return value.id.trim()
+  }
+  if (typeof safeBody.email === 'string' && safeBody.email.trim().length > 0) return safeBody.email.trim()
+  return undefined
+}
+
+/** 取出显式目标字段（不含 userId，便于区分 userId 是目标还是操作人）。 */
+function explicitShareTargetFrom(body) {
+  const safeBody = body && typeof body === 'object' ? body : {}
+  return (
+    safeBody.sharedWith ??
+    safeBody.sharedWithId ??
+    safeBody.sharedWithUserId ??
+    safeBody.targetUserId ??
+    safeBody.target ??
+    safeBody.to ??
+    safeBody.user ??
+    safeBody.email
+  )
+}
+
+/** 支持按用户 id 或邮箱查找分享对象。 */
+function findShareTarget(users, value) {
+  if (!value) return undefined
+  return value.includes('@') ? users.findByEmail(value) : users.get(value)
+}
