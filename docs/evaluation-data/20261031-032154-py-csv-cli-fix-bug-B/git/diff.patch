-    """按 UTF-8 读取整个 CSV，返回行列表。
+def _decode_csv(raw: bytes) -> str:
+    """按 UTF-8（含 BOM）→ GB18030 的顺序解码整份 CSV 字节。
 
-    已知缺陷：没有编码探测，GBK 文件会直接抛 UnicodeDecodeError；
-    UTF-8 BOM 会残留在第一个表头字段里（"\\ufeffid"）。
+    `utf-8-sig` 对无 BOM 的 UTF-8 透明，并会在解码时剥离 UTF-8 BOM；
+    `gb18030` 是 GBK/GB2312 的超集，用于客户提供的 GBK 文件。
+    两种候选编码都失败时，再用 `utf-8-sig` 解码一次，让
+    `UnicodeDecodeError` 带明确的位置信息向上抛出。
     """
-    with open(path, "r", encoding="utf-8", newline="") as handle:
-        return [row for row in csv.reader(handle)]
+    try:
+        return raw.decode("utf-8-sig")
+    except UnicodeDecodeError:
+        pass
+    try:
+        return raw.decode("gb18030")
+    except UnicodeDecodeError:
+        return raw.decode("utf-8-sig")
+
+
+def read_rows(path: str | Path) -> list[list[str]]:
+    """读取整个 CSV，自动适配 UTF-8（含 BOM）与 GBK/GB18030。"""
+    raw = Path(path).read_bytes()
+    text = _decode_csv(raw)
+    return [row for row in csv.reader(io.StringIO(text, newline=""))]
 
 
