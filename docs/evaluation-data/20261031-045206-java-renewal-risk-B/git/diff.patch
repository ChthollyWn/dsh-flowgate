@@ -0,0 +1,170 @@
+package com.acme.member.renewal;
+
+import com.acme.member.member.Member;
+import com.acme.member.member.MemberRepository;
+import com.acme.member.member.MemberService;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.http.ResponseEntity;
+
+import java.time.Clock;
+import java.time.Instant;
+import java.time.LocalDateTime;
+import java.time.ZoneId;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+/**
+ * 控制器 HTTP 契约：可选 timestamp、旧报文兼容、401/404/200 映射与响应不泄密。
+ *
+ * <p>直接调用控制器，不启动 Spring；固定服务器时间 2025-12-01T00:00:00Z。
+ */
+class RenewalCallbackHttpTest {
+
+    private static final Clock FIXED_CLOCK =
+            Clock.fixed(Instant.parse("2025-12-01T00:00:00Z"), ZoneId.of("Asia/Shanghai"));
+    private static final ZoneId ZONE = ZoneId.of("Asia/Shanghai");
+    private static final long NOW = 1764547200L;
+    private static final long TOLERANCE = 300L;
+    private static final String SECRET = "test-secret-A";
+    private static final String LEGACY_SECRET = "dev-secret-do-not-use-in-prod";
+
+    private MemberRepository memberRepository;
+    private MemberService memberService;
+    private RenewalRepository renewalRepository;
+    private SignatureVerifier signatureVerifier;
+    private RenewalController controller;
+    private Member member;
+
+    @BeforeEach
+    void setUp() {
+        memberRepository = new MemberRepository();
+        renewalRepository = new RenewalRepository();
+        memberService = new MemberService(memberRepository, FIXED_CLOCK, ZONE);
+        signatureVerifier = new SignatureVerifier(FIXED_CLOCK, SECRET, LEGACY_SECRET, true, TOLERANCE);
+        RenewalService renewalService =
+                new RenewalService(renewalRepository, memberService, signatureVerifier, FIXED_CLOCK, ZONE);
+        controller = new RenewalController(renewalService, renewalRepository);
+        member = memberService.register("张伟", "13800138000", LocalDateTime.parse("2026-01-15T00:00:00"));
+    }
+
+    @Test
+    void acceptsValidV2Callback() {
+        ResponseEntity<Map<String, Object>> response = controller.callback(v2Request("TXN-100", 9900L, NOW));
+
+        assertEquals(200, response.getStatusCode().value());
+        assertEquals(0, response.getBody().get("code"));
+        assertEquals(Boolean.FALSE, response.getBody().get("duplicate"));
+        assertEquals(1, renewalRepository.count());
+    }
+
+    @Test
+    void rejectsTamperedAmount() {
+        String signature = signatureVerifier.signV2("TXN-100", 9900L, NOW);
+        RenewalController.CallbackRequest tampered = new RenewalController.CallbackRequest(
+                "TXN-100", member.getId(), 1, 9901L, signature, NOW);
+
+        ResponseEntity<Map<String, Object>> response = controller.callback(tampered);
+
+        assertEquals(401, response.getStatusCode().value());
+        assertEquals(401, response.getBody().get("code"));
+        assertEquals(0, renewalRepository.count());
+    }
+
+    @Test
+    void rejectsV2CallbackWithoutTimestamp() {
+        String signature = signatureVerifier.signV2("TXN-100", 9900L, NOW);
+        RenewalController.CallbackRequest request = new RenewalController.CallbackRequest(
+                "TXN-100", member.getId(), 1, 9900L, signature, null);
+
+        ResponseEntity<Map<String, Object>> response = controller.callback(request);
+
+        assertEquals(401, response.getStatusCode().value());
+        assertEquals(0, renewalRepository.count());
+    }
+
+    @Test
+    void acceptsLegacyMd5CallbackDuringTransition() {
+        RenewalController.CallbackRequest legacy = new RenewalController.CallbackRequest(
+                "TXN-LEGACY", member.getId(), 1, 9900L, signatureVerifier.sign("TXN-LEGACY", 9900L));
+
+        ResponseEntity<Map<String, Object>> response = controller.callback(legacy);
+
+        assertEquals(200, response.getStatusCode().value());
+        assertEquals(1, renewalRepository.count());
+    }
+
+    @Test
+    void unknownMemberReturns404ForValidLegacySignature() {
+        RenewalController.CallbackRequest request = new RenewalController.CallbackRequest(
+                "TXN-MISSING", "no-such-member", 1, 9900L, signatureVerifier.sign("TXN-MISSING", 9900L));
+
+        ResponseEntity<Map<String, Object>> response = controller.callback(request);
+
+        assertEquals(404, response.getStatusCode().value());
+        assertEquals(404, response.getBody().get("code"));
+        assertEquals(0, renewalRepository.count());
+    }
+
+    @Test
+    void responseDoesNotLeakSecret() {
+        ResponseEntity<Map<String, Object>> response = controller.callback(v2Request("TXN-100", 9900L, NOW));
+        String body = String.valueOf(response.getBody());
+
+        assertFalse(body.contains(SECRET));
+        assertFalse(body.contains(LEGACY_SECRET));
+        assertFalse(body.toLowerCase().contains("secret"));
+    }
+
+    @Test
+    void legacyFiveFieldJsonStillDeserializes() throws Exception {
+        String legacySignature = signLegacy("TXN-JSON-LEGACY", 9900L);
+        String json = "{"
+                + "\"externalTxnId\":\"TXN-JSON-LEGACY\","
+                + "\"memberId\":\"" + member.getId() + "\","
+                + "\"months\":1,"
+                + "\"amountCents\":9900,"
+                + "\"signature\":\"" + legacySignature + "\""
+                + "}";
+
+        RenewalController.CallbackRequest request =
+                new ObjectMapper().readValue(json, RenewalController.CallbackRequest.class);
+
+        assertNull(request.timestamp());
+        assertEquals(200, controller.callback(request).getStatusCode().value());
+    }
+
+    @Test
+    void v2JsonWithTimestampDeserializes() throws Exception {
+        String signature = signatureVerifier.signV2("TXN-JSON-V2", 9900L, NOW);
+        String json = "{"
+                + "\"externalTxnId\":\"TXN-JSON-V2\","
+                + "\"memberId\":\"" + member.getId() + "\","
+                + "\"months\":1,"
+                + "\"amountCents\":9900,"
+                + "\"signature\":\"" + signature + "\","
+                + "\"timestamp\":" + NOW
+                + "}";
+
+        RenewalController.CallbackRequest request =
+                new ObjectMapper().readValue(json, RenewalController.CallbackRequest.class);
+
+        assertEquals(NOW, request.timestamp());
+        assertEquals(200, controller.callback(request).getStatusCode().value());
+    }
+
+    private RenewalController.CallbackRequest v2Request(String externalTxnId, long amountCents, long timestamp) {
+        String signature = signatureVerifier.signV2(externalTxnId, amountCents, timestamp);
+        return new RenewalController.CallbackRequest(
+                externalTxnId, member.getId(), 1, amountCents, signature, timestamp);
+    }
+
+    private static String signLegacy(String externalTxnId, long amountCents) {
+        return new SignatureVerifier(FIXED_CLOCK, SECRET, LEGACY_SECRET, true, TOLERANCE)
+                .sign(externalTxnId, amountCents);
+    }
+}
