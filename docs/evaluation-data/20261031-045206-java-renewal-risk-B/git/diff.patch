+package com.acme.member.renewal;
+
+import com.acme.member.member.Member;
+import com.acme.member.member.MemberRepository;
+import com.acme.member.member.MemberService;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import java.time.Clock;
+import java.time.Instant;
+import java.time.LocalDateTime;
+import java.time.ZoneId;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * 服务层时间戳透传与幂等契约。
+ *
+ * <p>固定服务器时间 2025-12-01T00:00:00Z（epoch 1764547200），容差 300 秒；
+ * 验签器使用 {@code test-secret-A}，覆盖 R2.S1/R2.S2/R2.S3 与 R5.S2。
+ */
+class RenewalCallbackTimestampTest {
+
+    private static final Clock FIXED_CLOCK =
+            Clock.fixed(Instant.parse("2025-12-01T00:00:00Z"), ZoneId.of("Asia/Shanghai"));
+    private static final ZoneId ZONE = ZoneId.of("Asia/Shanghai");
+    private static final long NOW = 1764547200L;
+    private static final long TOLERANCE = 300L;
+    private static final String SECRET = "test-secret-A";
+    private static final String LEGACY_SECRET = "dev-secret-do-not-use-in-prod";
+
+    private MemberRepository memberRepository;
+    private MemberService memberService;
+    private RenewalRepository renewalRepository;
+    private SignatureVerifier signatureVerifier;
+    private RenewalService renewalService;
+
+    @BeforeEach
+    void setUp() {
+        memberRepository = new MemberRepository();
+        renewalRepository = new RenewalRepository();
+        memberService = new MemberService(memberRepository, FIXED_CLOCK, ZONE);
+        signatureVerifier = new SignatureVerifier(FIXED_CLOCK, SECRET, LEGACY_SECRET, true, TOLERANCE);
+        renewalService = new RenewalService(renewalRepository, memberService, signatureVerifier, FIXED_CLOCK, ZONE);
+    }
+
+    @Test
+    void rejectsTimestampOutsideTolerance() {
+        Member member = registerMember();
+
+        for (long timestamp : new long[]{NOW - TOLERANCE - 1, NOW + TOLERANCE + 1}) {
+            RenewalService.CallbackCommand command =
+                    v2Command("TXN-TS-1", member.getId(), timestamp);
+            assertThrows(RenewalService.InvalidSignatureException.class,
+                    () -> renewalService.handleCallback(command));
+        }
+        assertEquals(0, renewalRepository.count());
+    }
+
+    @Test
+    void rejectsV2CallbackWithoutTimestamp() {
+        Member member = registerMember();
+        String signature = signatureVerifier.signV2("TXN-TS-2", 9900L, NOW);
+        RenewalService.CallbackCommand command = new RenewalService.CallbackCommand(
+                "TXN-TS-2", member.getId(), 1, 9900L, signature, null);
+
+        assertThrows(RenewalService.InvalidSignatureException.class,
+                () -> renewalService.handleCallback(command));
+        assertEquals(0, renewalRepository.count());
+    }
+
+    @Test
+    void acceptsTimestampExactlyOnToleranceBoundary() {
+        Member member = registerMember();
+        LocalDateTime before = member.getExpireAt();
+
+        RenewalService.CallbackResult result = renewalService.handleCallback(
+                v2Command("TXN-TS-3", member.getId(), NOW - TOLERANCE));
+
+        assertFalse(result.duplicate());
+        assertEquals(1, renewalRepository.count());
+        assertTrue(memberService.getMember(member.getId()).getExpireAt().isAfter(before));
+    }
+
+    @Test
+    void duplicateV2CallbackIsIdempotent() {
+        Member member = registerMember();
+        RenewalService.CallbackCommand command = v2Command("TXN-TS-4", member.getId(), NOW);
+
+        RenewalService.CallbackResult first = renewalService.handleCallback(command);
+        LocalDateTime afterFirst = memberService.getMember(member.getId()).getExpireAt();
+        RenewalService.CallbackResult second = renewalService.handleCallback(command);
+
+        assertFalse(first.duplicate());
+        assertTrue(second.duplicate());
+        assertEquals(1, renewalRepository.count());
+        assertEquals("TXN-TS-4", second.order().getExternalTxnId());
+        assertEquals(afterFirst, memberService.getMember(member.getId()).getExpireAt());
+    }
+
+    private Member registerMember() {
+        return memberService.register("张伟", "13800138000", LocalDateTime.parse("2026-01-15T00:00:00"));
+    }
+
+    private RenewalService.CallbackCommand v2Command(String externalTxnId, String memberId, long timestamp) {
+        String signature = signatureVerifier.signV2(externalTxnId, 9900L, timestamp);
+        return new RenewalService.CallbackCommand(
+                externalTxnId, memberId, 1, 9900L, signature, timestamp);
+    }
+}
diff --git a/src/test/java/com/acme/member/renewal/SignatureV2Test.java b/src/test/java/com/acme/member/renewal/SignatureV2Test.java
new file mode 100644
index 0000000..0da8626
--- /dev/null
+++ b/src/test/java/com/acme/member/renewal/SignatureV2Test.java
@@ -0,0 +1,142 @@
+package com.acme.member.renewal;
+
+import org.junit.jupiter.api.Test;
+
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.time.Clock;
+import java.time.Instant;
+import java.time.ZoneOffset;
+import java.util.Locale;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * 新验签契约：HMAC-SHA256 + 时间戳 + 外部密钥 + 新旧双验。
+ *
+ * <p>固定服务器时间为 2025-12-01T00:00:00Z（epoch 1764547200），容差 300 秒。
+ * 通过包级构造注入固定时钟与 test-secret-A，不启动 Spring。
+ */
+class SignatureV2Test {
+
+    private static final String NEW_SECRET = "test-secret-A";
+    private static final String LEGACY_SECRET = "dev-secret-do-not-use-in-prod";
+    private static final long NOW = 1764547200L;
+    private static final long TOLERANCE = 300L;
+
+    private static final Clock FIXED_CLOCK =
+            Clock.fixed(Instant.parse("2025-12-01T00:00:00Z"), ZoneOffset.UTC);
+
+    private final SignatureVerifier verifier =
+            new SignatureVerifier(FIXED_CLOCK, NEW_SECRET, LEGACY_SECRET, true, TOLERANCE);
+
+    private final SignatureVerifier legacyDisabled =
+            new SignatureVerifier(FIXED_CLOCK, NEW_SECRET, LEGACY_SECRET, false, TOLERANCE);
+
+    @Test
+    void acceptsValidV2Signature() {
+        String signature = verifier.signV2("TXN-100", 9900L, NOW);
+        assertTrue(verifier.verify("TXN-100", 9900L, NOW, signature));
+    }
+
+    @Test
+    void acceptsV2SignatureWithUppercaseHex() {
+        String signature = verifier.signV2("TXN-100", 9900L, NOW);
+        String uppercaseHex = "v2:" + signature.substring(3).toUpperCase(Locale.ROOT);
+        assertTrue(verifier.verify("TXN-100", 9900L, NOW, uppercaseHex));
+    }
+
+    @Test
+    void rejectsTamperedAmount() {
+        String signature = verifier.signV2("TXN-100", 9900L, NOW);
+        assertFalse(verifier.verify("TXN-100", 9901L, NOW, signature));
+    }
+
+    @Test
+    void rejectsTamperedTransactionId() {
+        String signature = verifier.signV2("TXN-100", 9900L, NOW);
+        assertFalse(verifier.verify("TXN-101", 9900L, NOW, signature));
+    }
+
+    @Test
+    void rejectsTimestampOutsideTolerance() {
+        long tooEarly = NOW - TOLERANCE - 1;
+        long tooLate = NOW + TOLERANCE + 1;
+        assertFalse(verifier.verify("TXN-100", 9900L, tooEarly,
+                verifier.signV2("TXN-100", 9900L, tooEarly)));
+        assertFalse(verifier.verify("TXN-100", 9900L, tooLate,
+                verifier.signV2("TXN-100", 9900L, tooLate)));
+    }
+
+    @Test
+    void acceptsTimestampExactlyOnToleranceBoundary() {
+        long earliest = NOW - TOLERANCE;
+        long latest = NOW + TOLERANCE;
+        assertTrue(verifier.verify("TXN-100", 9900L, earliest,
+                verifier.signV2("TXN-100", 9900L, earliest)));
+        assertTrue(verifier.verify("TXN-100", 9900L, latest,
+                verifier.signV2("TXN-100", 9900L, latest)));
+    }
+
+    @Test
+    void rejectsMissingTimestampForV2Signature() {
+        String signature = verifier.signV2("TXN-100", 9900L, NOW);
+        assertFalse(verifier.verify("TXN-100", 9900L, null, signature));
+    }
+
+    @Test
+    void rejectsBlankSignature() {
+        assertFalse(verifier.verify("TXN-100", 9900L, NOW, null));
+        assertFalse(verifier.verify("TXN-100", 9900L, NOW, ""));
+        assertFalse(verifier.verify("TXN-100", 9900L, NOW, "   "));
+        assertFalse(verifier.verify("TXN-100", 9900L, null));
+    }
+
+    @Test
+    void acceptsLegacyMd5WhileTransitionEnabled() {
+        String legacySignature = signLegacy("TXN-100", 9900L);
+        assertTrue(verifier.verify("TXN-100", 9900L, legacySignature));
+        assertTrue(verifier.verify("TXN-100", 9900L, legacySignature.toUpperCase(Locale.ROOT)));
+    }
+
+    @Test
+    void rejectsLegacyMd5WhenTransitionDisabled() {
+        String legacySignature = signLegacy("TXN-100", 9900L);
+        assertFalse(legacyDisabled.verify("TXN-100", 9900L, legacySignature));
+    }
+
+    @Test
+    void configuredSecretReplacesHardcodedKey() {
+        // 用当前开发密钥（旧硬编码值）生成的 v2 签名，在 test-secret-A 下必须失败。
+        SignatureVerifier withOldSecret =
+                new SignatureVerifier(FIXED_CLOCK, LEGACY_SECRET, LEGACY_SECRET, true, TOLERANCE);
+        String signedWithOldSecret = withOldSecret.signV2("TXN-100", 9900L, NOW);
+        assertFalse(verifier.verify("TXN-100", 9900L, NOW, signedWithOldSecret));
+        assertTrue(verifier.verify("TXN-100", 9900L, NOW,
+                verifier.signV2("TXN-100", 9900L, NOW)));
+    }
+
+    @Test
+    void legacyEntryPointDoesNotAcceptV2Signature() {
+        String v2Signature = verifier.signV2("TXN-100", 9900L, NOW);
+        assertFalse(verifier.verify("TXN-100", 9900L, v2Signature));
+    }
+
+    private static String signLegacy(String externalTxnId, long amountCents) {
+        String payload = externalTxnId + ":" + amountCents + ":" + LEGACY_SECRET;
+        try {
+            byte[] hashed = MessageDigest.getInstance("MD5")
+                    .digest(payload.getBytes(StandardCharsets.UTF_8));
+            StringBuilder builder = new StringBuilder(hashed.length * 2);
+            for (byte value : hashed) {
+                builder.append(Character.forDigit((value >> 4) & 0xF, 16));
+                builder.append(Character.forDigit(value & 0xF, 16));
+            }
+            return builder.toString();
+        } catch (NoSuchAlgorithmException exception) {
+            throw new IllegalStateException("MD5 不可用", exception);
+        }
+    }
+}
