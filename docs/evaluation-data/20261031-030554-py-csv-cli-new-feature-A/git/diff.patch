+def _parse_key_columns(parser: argparse.ArgumentParser, values: list[str] | None):
+    if not values:
+        return None
+    columns: list[str] = []
+    for value in values:
+        columns.extend(part.strip() for part in value.split(",") if part.strip())
+    if not columns:
+        parser.error("--key 不能为空")
+    return columns
+
