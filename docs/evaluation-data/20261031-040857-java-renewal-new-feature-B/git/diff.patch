@@ -0,0 +1,54 @@
+package com.acme.member.renewal;
+
+import org.springframework.stereotype.Repository;
+
+import java.util.Optional;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ConcurrentMap;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/** 内存券仓储，按券码存储（大小写敏感）。 */
+@Repository
+public class CouponRepository {
+
+    private final ConcurrentMap<String, Coupon> coupons = new ConcurrentHashMap<>();
+
+    public Coupon save(Coupon coupon) {
+        coupons.put(coupon.getCode(), coupon);
+        return coupon;
+    }
+
+    public Optional<Coupon> findByCode(String code) {
+        return Optional.ofNullable(coupons.get(code));
+    }
+
+    /**
+     * 原子占券：仅当券存在、状态 ACTIVE 且未核销时写入 {@code usedOrderId}。
+     * 同一张券并发核销只会有一个调用成功。
+     *
+     * @return true 表示本次调用完成核销
+     */
+    public boolean redeem(String code, String orderId) {
+        if (code == null) {
+            return false;
+        }
+        AtomicBoolean redeemed = new AtomicBoolean(false);
+        coupons.computeIfPresent(code, (key, coupon) -> {
+            if (!coupon.isActive() || coupon.isUsed()) {
+                return coupon;
+            }
+            coupon.markUsed(orderId);
+            redeemed.set(true);
+            return coupon;
+        });
+        return redeemed.get();
+    }
+
+    public long count() {
+        return coupons.size();
+    }
+
+    public void clear() {
+        coupons.clear();
+    }
+}
