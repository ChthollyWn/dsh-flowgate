@@ -0,0 +1,90 @@
+package com.acme.member.renewal;
+
+import java.time.LocalDateTime;
+
+/**
+ * 优惠券。
+ *
+ * <p>券码非空且大小写敏感；折扣率取值 {@code (0, 1]}，1.0 表示无折扣。
+ * {@code expiresAt} 为 null 表示永不过期；{@code usedOrderId} 为 null 表示未核销。
+ * 构造时即校验非法定义，保证非法券不会进入仓储（R1.S2、R1.S3）。
+ */
+public class Coupon {
+
+    public enum Status {
+        ACTIVE,
+        DISABLED
+    }
+
+    private final String code;
+    private final double discountRate;
+    private final Status status;
+    private final LocalDateTime expiresAt;
+    private volatile String usedOrderId;
+
+    public Coupon(String code, double discountRate) {
+        this(code, discountRate, Status.ACTIVE, null, null);
+    }
+
+    public Coupon(String code, double discountRate, LocalDateTime expiresAt) {
+        this(code, discountRate, Status.ACTIVE, expiresAt, null);
+    }
+
+    public Coupon(String code, double discountRate, Status status, LocalDateTime expiresAt) {
+        this(code, discountRate, status, expiresAt, null);
+    }
+
+    public Coupon(String code, double discountRate, Status status, LocalDateTime expiresAt, String usedOrderId) {
+        if (code == null || code.isBlank()) {
+            throw new IllegalArgumentException("券码不能为空");
+        }
+        if (!Double.isFinite(discountRate) || discountRate <= 0.0 || discountRate > 1.0) {
+            throw new IllegalArgumentException("折扣率必须在 (0, 1] 区间内");
+        }
+        this.code = code;
+        this.discountRate = discountRate;
+        this.status = status == null ? Status.ACTIVE : status;
+        this.expiresAt = expiresAt;
+        this.usedOrderId = usedOrderId;
+    }
+
+    public String getCode() {
+        return code;
+    }
+
+    public double getDiscountRate() {
+        return discountRate;
+    }
+
+    public Status getStatus() {
+        return status;
+    }
+
+    public LocalDateTime getExpiresAt() {
+        return expiresAt;
+    }
+
+    public String getUsedOrderId() {
+        return usedOrderId;
+    }
+
+    public boolean isActive() {
+        return status == Status.ACTIVE;
+    }
+
+    public boolean isUsed() {
+        return usedOrderId != null;
+    }
+
+    /** 过期判定：严格早于当前时刻才算过期，等于当前时刻仍有效。 */
+    public boolean isExpired(LocalDateTime now) {
+        return expiresAt != null && expiresAt.isBefore(now);
+    }
+
+    void markUsed(String orderId) {
+        if (orderId == null || orderId.isBlank()) {
+            throw new IllegalArgumentException("核销订单号不能为空");
+        }
+        this.usedOrderId = orderId;
+    }
+}
diff --git a/src/main/java/com/acme/member/renewal/CouponRepository.java b/src/main/java/com/acme/member/renewal/CouponRepository.java
