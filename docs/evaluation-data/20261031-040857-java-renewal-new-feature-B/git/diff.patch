+package com.acme.member.renewal;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/** R1 券模型与内存仓储。 */
+class CouponRepositoryTest {
+
+    private CouponRepository couponRepository;
+
+    @BeforeEach
+    void setUp() {
+        couponRepository = new CouponRepository();
+    }
+
+    @Test
+    void registersActiveCoupon() {
+        couponRepository.save(new Coupon("SAVE20", 0.80));
+
+        Coupon found = couponRepository.findByCode("SAVE20").orElseThrow();
+        assertEquals("SAVE20", found.getCode());
+        assertEquals(0.80, found.getDiscountRate());
+        assertEquals(Coupon.Status.ACTIVE, found.getStatus());
+        assertNull(found.getExpiresAt());
+        assertNull(found.getUsedOrderId());
+        assertEquals(1, couponRepository.count());
+    }
+
+    @Test
+    void rejectsBlankCouponCodeWithoutSaving() {
+        assertThrows(IllegalArgumentException.class, () -> couponRepository.save(new Coupon("", 0.80)));
+        assertThrows(IllegalArgumentException.class, () -> couponRepository.save(new Coupon("   ", 0.80)));
+        assertEquals(0, couponRepository.count());
+    }
+
+    @Test
+    void rejectsOutOfRangeDiscountRateWithoutSaving() {
+        assertThrows(IllegalArgumentException.class, () -> couponRepository.save(new Coupon("BAD", 0)));
+        assertThrows(IllegalArgumentException.class, () -> couponRepository.save(new Coupon("NEGATIVE", -0.1)));
+        assertThrows(IllegalArgumentException.class, () -> couponRepository.save(new Coupon("HIGH", 1.01)));
+        assertEquals(0, couponRepository.count());
+    }
+
+    @Test
+    void acceptsFullPriceRateAndCaseSensitiveCodes() {
+        couponRepository.save(new Coupon("FULL", 1.0));
+        couponRepository.save(new Coupon("SAVE20", 0.80));
+
+        assertEquals(1.0, couponRepository.findByCode("FULL").orElseThrow().getDiscountRate());
+        assertTrue(couponRepository.findByCode("save20").isEmpty());
+    }
+
+    @Test
+    void redeemClaimsCouponOnlyOnce() {
+        couponRepository.save(new Coupon("SAVE20", 0.80));
+
+        assertTrue(couponRepository.redeem("SAVE20", "order-1"));
+        assertEquals("order-1", couponRepository.findByCode("SAVE20").orElseThrow().getUsedOrderId());
+
+        assertFalse(couponRepository.redeem("SAVE20", "order-2"));
+        assertEquals("order-1", couponRepository.findByCode("SAVE20").orElseThrow().getUsedOrderId());
+
+        assertFalse(couponRepository.redeem("NOPE", "order-3"));
+        assertTrue(couponRepository.findByCode("NOPE").isEmpty());
+    }
+}
