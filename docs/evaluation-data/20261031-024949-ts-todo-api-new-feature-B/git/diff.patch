index 0000000..4457c2f
--- /dev/null
+++ b/src/shares.js
@@ -0,0 +1,73 @@
+import { randomBytes } from 'node:crypto'
+
+const TOKEN_BYTES = 24
+
+/**
+ * 分享存储。主索引 token → 记录，次索引 todoId → token 集合，
+ * 两者必须同步增删，保证按 token 查询与按待办级联撤销都是常数/线性开销。
+ */
+export class ShareStore {
+  constructor({ now = () => new Date().toISOString() } = {}) {
+    this.now = now
+    this.byToken = new Map()
+    this.byTodo = new Map()
+  }
+
+  /** 创建分享；token 冲突时重抽，保证全局唯一。 */
+  create(todoId) {
+    let token = randomBytes(TOKEN_BYTES).toString('base64url')
+    while (this.byToken.has(token)) {
+      token = randomBytes(TOKEN_BYTES).toString('base64url')
+    }
+    const share = { token, todoId, createdAt: this.now() }
+    this.byToken.set(token, share)
+    let tokens = this.byTodo.get(todoId)
+    if (!tokens) {
+      tokens = new Set()
+      this.byTodo.set(todoId, tokens)
+    }
+    tokens.add(token)
+    return share
+  }
+
+  get(token) {
+    return this.byToken.get(token)
+  }
+
+  /** 仅返回未撤销的分享，按创建顺序。 */
+  listByTodo(todoId) {
+    const tokens = this.byTodo.get(todoId)
+    if (!tokens) return []
+    const shares = []
+    for (const token of tokens) {
+      const share = this.byToken.get(token)
+      if (share) shares.push(share)
+    }
+    return shares
+  }
+
+  /** token 不存在或不属于该待办时返回 false，且不产生任何变更。 */
+  revoke(todoId, token) {
+    const share = this.byToken.get(token)
+    if (!share || share.todoId !== todoId) return false
+    this.byToken.delete(token)
+    const tokens = this.byTodo.get(todoId)
+    if (tokens) {
+      tokens.delete(token)
+      if (tokens.size === 0) this.byTodo.delete(todoId)
+    }
+    return true
+  }
+
+  /** 级联撤销某待办的全部分享，返回实际删除数量。 */
+  revokeAllForTodo(todoId) {
+    const tokens = this.byTodo.get(todoId)
+    if (!tokens) return 0
+    let removed = 0
+    for (const token of tokens) {
+      if (this.byToken.delete(token)) removed += 1
+    }
+    this.byTodo.delete(todoId)
+    return removed
+  }
+}
