 """CSV 读写工具。
 
-基准任务 R2（GBK 乱码）的目标文件：当前实现只按 UTF-8 读取，
-遇到 GBK 编码或带 BOM 的文件会报 UnicodeDecodeError 或把 BOM 带进首列。
+读取时自动识别常见编码：UTF-8（含 BOM）以及 GBK/GB2312（用其超集
+GB18030 解码）。写出一律使用不带 BOM 的 UTF-8。
 """
 from __future__ import annotations
 
@@ -9,14 +9,30 @@ import csv
 import io
 from pathlib import Path
 
+# 按顺序尝试；utf-8-sig 同时兼容带 BOM 和不带 BOM 的 UTF-8，
+# gb18030 是 GBK / GB2312 的超集。
+_DECODE_ENCODINGS = ("utf-8-sig", "gb18030")
+
+
+def _decode_csv(raw: bytes) -> str:
+    """把 CSV 原始字节解码成文本，依次尝试 UTF-8（含 BOM）和 GB18030。"""
+    for encoding in _DECODE_ENCODINGS:
+        try:
+            return raw.decode(encoding)
+        except UnicodeDecodeError:
+            continue
+    # 两种编码都失败时，用 UTF-8 的异常给出明确的错误位置。
+    return raw.decode("utf-8-sig")
+
 
 def read_rows(path: str | Path) -> list[list[str]]:
-    """按 UTF-8 读取整个 CSV，返回行列表。
+    """读取整个 CSV，返回行列表。
 
-    已知缺陷：没有编码探测，GBK 文件会直接抛 UnicodeDecodeError；
-    UTF-8 BOM 会残留在第一个表头字段里（"\\ufeffid"）。
+    自动识别 UTF-8（含 BOM）与 GBK/GB18030 编码；UTF-8 BOM 不会
+    残留在第一个表头字段里。
     """
-    with open(path, "r", encoding="utf-8", newline="") as handle:
+    text = _decode_csv(Path(path).read_bytes())
+    with io.StringIO(text, newline="") as handle:
         return [row for row in csv.reader(handle)]
 
 
